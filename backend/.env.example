PORT=3000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key

# Google Gemini (Get free key starting with 'AIza...' or 'AQ...' from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key


# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Azure Speech
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=your_azure_region

# CORS (production frontend URL)
CORS_ORIGIN=http://localhost:5173

# Public URL of the frontend, used to build the links in verification and
# password-reset emails. Must be the deployed origin in production.
CLIENT_URL=http://localhost:5173


SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
MAIL_FROM=Mock Interview <no-reply@yourdomain.com>
MAIL_REPLY_TO=support@yourdomain.com

# Judge0 (self-hosted URL, or RapidAPI URL + key)
JUDGE0_URL=http://localhost:2358
JUDGE0_KEY=
